#   Protection   : publique
LEAD_CENTRAL_EMAIL_ENABLED=

# ──────────────────────────────────────────────────────────────────────
# LEAD_CENTRAL_EMAIL_NETTOYAGE
#   Service      : CRM — centralisation
#   Utilisation  : Destinataire de centralisation des secteurs nettoyage,
