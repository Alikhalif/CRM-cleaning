# ── Supabase ──────────────────────────────────────────────────────────
# Copy this file to .env.local and fill the values. .env.local is gitignored
# by Next.js + the project's own .gitignore.
#
# Find these in Supabase dashboard → Project Settings → API.

# Project URL — visible to the browser, hence the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Anon key — RLS-respecting, safe to ship in the browser bundle.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Service-role key — BYPASSES RLS. Server-only. Never ever expose this to the
# browser bundle. CDC §8.2 calls this out explicitly as an audit checkpoint.
# Never commit the real value here — keep it in .env.local only.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Newer publishable-key system (replaces anon in some SDK paths).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>

# Note: feature flags (e.g., n8n auto-sequence on/off) live in the
# `app_settings` database table and are flipped at runtime from
# /settings/integrations — admins don't need to redeploy to toggle.

# ── Cron / évaluation des alertes (OBLIGATOIRE en prod) ───────────────────
# Sans cette valeur, le moteur d'alertes/relances (photos, découverte, devis,
# lead non traité, expiration des contrats) ne tourne QUE lorsqu'un Super Admin
# rafraîchit manuellement. Défini ce secret, puis planifie un appel récurrent
# (toutes les 1–2 min) vers POST /api/presence/evaluate avec l'en-tête
# `x-cron-secret: <valeur>`. Voir docs/CRON.md (correctif recette A02).
PRESENCE_CRON_SECRET=<chaîne-aléatoire-longue>

# ── Secrets webhooks / intégrations (à définir en prod) ───────────────────
# En DEV, si ces secrets sont absents, les webhooks correspondants acceptent
# les requêtes non signées (pratique en local). En PROD, définis-les tous,
# sinon les endpoints restent ouverts (durcissement recette A10).
LEADS_INBOUND_SECRET=<hmac-WF1-lead-capture>      # webhook n8n → /api/webhooks/leads/inbound
N8N_TO_CRM_BEARER=<bearer-poll-statut>            # n8n → GET /api/leads/[id]/status + PATCH
N8N_WF2_TRIGGER_URL=<url-webhook-relance-devis>   # CRM → n8n (séquence WF2)
N8N_WF2_TRIGGER_SECRET=<x-trigger-secret-WF2>
BREVO_INBOUND_SECRET=<secret-reponses-email>      # Brevo inbound → /api/webhooks/brevo/inbound
BREVO_EVENTS_TOKEN=<token-events-brevo>           # Brevo events → /api/webhooks/brevo/events
RINGOVER_WEBHOOK_SECRET=<secret-events-ringover>  # Ringover → /api/webhooks/ringover

# ── Chiffrement applicatif des champs confidentiels (recette A14) ─────────
# Clé AES-256-GCM (32 octets) chiffrant au repos les champs confidentiels :
# l'annotation Immobilier/Travaux (CDC §3.5) ET la provenance marketing des
# leads (source_url / utm_* / gclid, chaîne d'arrivée §5-8). Sans elle, ces
# valeurs restent lisibles en base via la clé anon par le propriétaire du lead.
# Génère-la avec :
#   openssl rand -hex 32        (64 caractères hexadécimaux)
#   openssl rand -base64 32     (base64)
# Tant qu'elle est absente, ces champs sont stockés en clair (comportement
# actuel) ; dès qu'elle est définie, les nouvelles écritures sont chiffrées. Ne
# jamais la perdre (les valeurs chiffrées deviendraient illisibles) ni la commiter.
FIELD_ENCRYPTION_KEY=<clé-32-octets-hex-ou-base64>

# ── Centralisation email des leads (chaîne d'arrivée §10-13) ──────────────
# Par défaut, la centralisation email est assurée par n8n (WF1) qui route déjà
# par secteur → le CRM N'ENVOIE PAS de copie (évite le doublon).
# Mettre LEAD_CENTRAL_EMAIL_ENABLED=true UNIQUEMENT si tu veux que le CRM devienne
# la source de la centralisation À LA PLACE de n8n (et alors retirer le nœud
# email de WF1). Le CRM route Nettoyage vs Déménagement + joint la provenance.
LEAD_CENTRAL_EMAIL_ENABLED=false
LEAD_CENTRAL_EMAIL_NETTOYAGE=leadnettoyage360@gmail.com     # nettoyage / nettoyage_difficile / diogène / débarras
LEAD_CENTRAL_EMAIL_DEMENAGEMENT=lead.dem360@gmail.com        # demenagement
