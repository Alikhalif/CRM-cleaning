# ══════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# BREVO_EVENTS_TOKEN
#   Service      : Brevo — evenements
#   Utilisation  : Jeton du webhook des ouvertures et clics.
#   Obligatoire  : obligatoire en production
#   Environnement: production
#   Valeur       : chaine aleatoire longue
#   Si absente   : en production le webhook refuse (fail-closed) ; en
#                   developpement il accepte.
#   Repli        : fail-closed en production
#   Protection   : SECRET
BREVO_EVENTS_TOKEN=


# ══════════════════════════════════════════════════════════════════════════
#  RINGOVER
# ══════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# RINGOVER_WEBHOOK_SECRET
#   Service      : Ringover
#   Utilisation  : Secret du webhook des evenements d'appel.
#   Obligatoire  : obligatoire en production
#   Environnement: production
#   Valeur       : chaine aleatoire longue
#   Si absente   : ⚠️ en developpement, les requetes non signees sont
#                   acceptees.
#   Repli        : aucune verification en developpement
#   Protection   : SECRET
RINGOVER_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────────────
# RINGOVER_API_KEY
#   Service      : Ringover
#   Utilisation  : Cle API : webphone embarque, SMS, remontee d'appels.
#   Obligatoire  : obligatoire en production
#   Environnement: production
#   Valeur       : cle du compte Ringover
#   Si absente   : le webphone ne se monte pas ; aucun appel ni SMS reel n'est
#                   possible.
#   Repli        : aucun
#   Protection   : SECRET. En recette : LAISSER ABSENTE (Ringover n'a pas de
#                   bac a sable).
RINGOVER_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# RINGOVER_API_BASE
#   Service      : Ringover
#   Utilisation  : Base de l'API Ringover.
#   Obligatoire  : facultative
#   Environnement: production
#   Valeur       : https://public-api.ringover.com/v2
#   Si absente   : repli sur la base par defaut.
#   Repli        : base par defaut
#   Protection   : publique
RINGOVER_API_BASE=


# ══════════════════════════════════════════════════════════════════════════
#  DOCUSIGN
# ══════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# DOCUSIGN_ENV
#   Service      : DocuSign
#   Utilisation  : « demo » = bac a sable, « production » = comptes reels.
#                   Toute autre valeur, ou l'absence, vaut « demo ».
#   Obligatoire  : recommandee
#   Environnement: production · recette
#   Valeur       : demo | production
#   Si absente   : repli « demo » : une variable oubliee n'envoie jamais un
#                   vrai contrat.
#   Repli        : demo
#   Protection   : publique
DOCUSIGN_ENV=

# ──────────────────────────────────────────────────────────────────────
# DOCUSIGN_CLIENT_ID
#   Service      : DocuSign
#   Utilisation  : Integration Key de l'application « Authorization Code Grant
#                   ».
#   Obligatoire  : obligatoire si DocuSign est raccorde
#   Environnement: production · recette
#   Valeur       : identifiant d'integration
#   Si absente   : generation et telechargement des contrats continuent ; seul
#                   l'envoi en signature est refuse.
#   Repli        : aucun — refus nomme
#   Protection   : SECRET. En recette : LAISSER ABSENTE.
DOCUSIGN_CLIENT_ID=

# ──────────────────────────────────────────────────────────────────────
# DOCUSIGN_CLIENT_SECRET
#   Service      : DocuSign
#   Utilisation  : Secret de l'application DocuSign.
#   Obligatoire  : obligatoire si DocuSign est raccorde
#   Environnement: production · recette
#   Valeur       : cle secrete de l'application
#   Si absente   : le raccordement OAuth est refuse.
#   Repli        : aucun
#   Protection   : SECRET
DOCUSIGN_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────────────
# DOCUSIGN_REDIRECT_URI
#   Service      : DocuSign
#   Utilisation  : URI de redirection OAuth, a declarer A L'IDENTIQUE chez
#                   DocuSign. Sert aussi a deduire l'origine de retour.
#   Obligatoire  : obligatoire si DocuSign est raccorde
#   Environnement: production · recette
#   Valeur       : http://localhost:3000/api/docusign/callback
#   Si absente   : le raccordement OAuth est refuse.
#   Repli        : aucun
#   Protection   : publique. ⚠️ Verifier qu'elle ne pointe pas sur la
#                   production depuis un poste local.
DOCUSIGN_REDIRECT_URI=

# ──────────────────────────────────────────────────────────────────────
# DOCUSIGN_CONNECT_HMAC_SECRET
#   Service      : DocuSign
#   Utilisation  : Cle HMAC de DocuSign Connect. Sans elle, AUCUNE notification
#                   de signature n'est acceptee.
#   Obligatoire  : obligatoire si DocuSign est raccorde
#   Environnement: production · recette
#   Valeur       : cle HMAC generee dans DocuSign
#   Si absente   : le contrat partirait sans que son retour de signature puisse
#                   etre enregistre : le raccordement l'exige donc des le
#                   depart.
#   Repli        : aucun — refus
#   Protection   : SECRET
DOCUSIGN_CONNECT_HMAC_SECRET=


# ══════════════════════════════════════════════════════════════════════════
#  CRM — CENTRALISATION
# ══════════════════════════════════════════════════════════════════════════

