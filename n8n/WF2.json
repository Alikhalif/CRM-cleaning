      "id": "01-trigger",
      "name": "Trigger (CRM → n8n)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 360],
      "webhookId": "wf2-relance-devis"
    },
    {
      "parameters": {
        "jsCode": "const expected = $env.WF2_TRIGGER_SECRET;\nconst got = $input.first().json.headers['x-trigger-secret'] ?? '';\nif (!expected || got !== expected) {\n  throw new Error('UNAUTHORIZED');\n}\nconst body = $input.first().json.body ?? {};\nif (!body.lead_id || !body.client_email) {\n  throw new Error('MISSING_FIELDS: lead_id and client_email are required');\n}\nreturn [{ json: {\n  lead_id: body.lead_id,\n  client_email: body.client_email,\n  client_first_name: body.client_first_name ?? '',\n  commercial_name: body.commercial_name ?? 'Notre équipe',\n  quote_url: body.quote_url ?? '',\n  quote_ref: body.quote_ref ?? ''\n}}];"
      },
      "id": "02-auth",
      "name": "Check Trigger Secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 360]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.CRM_BASE_URL }}/api/leads/{{ $json.lead_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'envoye', source: 'n8n-wf2-simple' }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "03-mark-envoye",
      "name": "CRM: status=envoye",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [620, 360],
      "credentials": {
        "httpHeaderAuth": { "id": "crm-bearer", "name": "CRM Bearer" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/smtp/email",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "accept", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: [{ email: $('Check Trigger Secret').first().json.client_email }], templateId: parseInt($env.BREVO_TPL_E1, 10), params: { FIRST_NAME: $('Check Trigger Secret').first().json.client_first_name, COMMERCIAL_NAME: $('Check Trigger Secret').first().json.commercial_name, QUOTE_URL: $('Check Trigger Secret').first().json.quote_url, QUOTE_REF: $('Check Trigger Secret').first().json.quote_ref } }) }}",
        "options": { "timeout": 12000 }
