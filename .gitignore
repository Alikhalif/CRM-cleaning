# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Gabarit de l'environnement de RECETTE. Suivi comme .env.example : il ne
# contient que des valeurs descriptives, et c'est lui qui explique pourquoi
# `npm run dev` refuse de demarrer sans configuration.
!.env.recette.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI artifacts — keep migrations + seed + config.toml versioned;
# ignore the local temp/branch state.
supabase/.temp/
supabase/.branches/
supabase/.env

# n8n workflows remplis avec des secrets réels — jamais commités
n8n/*.local.json

# Références devis (ne pas versionner)
api.py
devis-template.zip
optimivv-devis.zip

# Caches Python des scripts utilitaires (neutralisation du gabarit, etc.)
__pycache__/
*.pyc

# Messages captures par la garde d'envoi (recette/developpement).
# Ils contiennent des donnees de test ET les pieces jointes qui auraient ete
# envoyees : ils ne doivent jamais entrer dans le depot.
var/

# Echantillons PDF des lots A, B et E : 25 fichiers, 19 Mo de binaires.
#
# Git ne les compresse pas en delta : chaque regeneration ajouterait 19 Mo
# a l'historique DEFINITIVEMENT, et on ne peut les en retirer qu'en
# reecrivant l'historique — ce que les regles du projet interdisent.
#
# Leur contenu probant est conserve dans docs/ECHANTILLONS-PDF.md : ce que
# chacun demontre, son empreinte, et la commande qui le regenere. Et la
# preuve DURABLE n'est pas dans ces fichiers mais dans les suites
# automatisees, qui extraient la couche texte et se rejouent.
echantillons-lot-*/
